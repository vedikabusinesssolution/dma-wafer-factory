<!DOCTYPE html>
<html>
<head>
    <title>Final DMA Report</title>
    <style>
        body { font-family: Arial; padding:20px; }
        table { width:50%; border-collapse: collapse; margin-bottom:20px; }
        th, td { border:1px solid #ccc; padding:8px; text-align:left; }
        th { background:#f2f2f2; }
        h2,h3 { margin-top:20px; }
        button { padding:10px 15px; background:green; color:white; border:none; cursor:pointer; border-radius:5px; }
    </style>
</head>
<body>

<h1>Final DMA Report</h1>

<h3>Introduction</h3>
<p>{{intro}}</p>

<h3>Methodology</h3>
<p>{{methodology}}</p>

<h3>Score Scale</h3>
<p>0 = Poor, 5 = Excellent</p>

<h2>Pillar Average Scores</h2>
<table>
    <tr>
        <th>Pillar</th>
        <th>Average Score (0-5)</th>
    </tr>
    {{#each pillarScores}}
    <tr>
        <td>{{this.pillar}}</td>
        <td>{{this.avg_score}}</td>
    </tr>
    {{/each}}
</table>

<div style="margin-top:20px;">
    <a href="/dashboard/download-final-report"><button>Download PDF</button></a>
</div>
<div style="margin-top:20px;">
    <a href="/dashboard">
       <button>⏮ Back to Dashboard</button>
    </a>
</div>

</body>
</html>

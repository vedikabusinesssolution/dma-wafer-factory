<!DOCTYPE html>
<html>
<head>
    <title>DMA Dashboard</title>
    <style>
        body { font-family: Arial; padding:20px; }
        h1 { text-align:center; }
        table { width:100%; border-collapse:collapse; margin-top:20px; }
        th, td { border:1px solid #ccc; padding:10px; text-align:center; }
        th { background:#f2f2f2; }
        a.button { display:inline-block; padding:10px 20px; background:green; color:white; text-decoration:none; border-radius:5px; }
    </style>
</head>
<body>
<h1>DMA Dashboard</h1>
<p>Welcome, {{user}}! <a href="/logout">Logout</a></p>

<a class="button" href="/dashboard/process/1">Start/Continue DMA Questionnaire</a>

<h2>Process Status</h2>
<table>
<tr><th>Process</th><th>Status</th></tr>
{{#each processes}}
<tr>
    <td>{{this.name}}</td>
    <td>{{#if (includes ../completedProcesses this.id)}}Completed{{else}}Pending{{/if}}</td>
</tr>
{{/each}}
</table>
</body>
</html>

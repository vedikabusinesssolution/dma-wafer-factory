<!DOCTYPE html>
<html>
<head>
    <title>DMA</title>
    <style>
        body { font-family: Arial; margin:0; padding:0; }

        .stepper-wrapper {
            display: flex;
            justify-content: space-between;
            padding: 15px;
            position: sticky;
            top:0;
            background:#f5f5f5;
            border-bottom:2px solid #ddd;
            z-index:100;
        }

        .stepper-item {
            text-align:center;
            width:150px;
            opacity: 0.6;
        }

        .stepper-item.completed {
            opacity: 1;
        }

        .step-counter {
            width:30px;
            height:30px;
            border-radius:50%;
            background:lightgray;
            margin:0 auto;
            line-height:30px;
            font-weight:bold;
        }

        .stepper-item.completed .step-counter {
            background:green;
            color:white;
        }

        .step-name { margin-top:5px; }

        .question-container {
            max-height:70vh;
            overflow-y:auto;
            padding:20px;
            margin:20px;
            border:1px solid #ccc;
            border-radius:8px;
            background:#fafafa;
        }

        .question-block { margin-bottom:20px; }

        label {
            display:block;
            font-weight:bold;
            margin-bottom:5px;
        }

        input, select {
            width:100%;
            padding:8px;
            margin-bottom:10px;
            border-radius:4px;
            border:1px solid #ccc;
        }

        button {
            padding:10px 20px;
            background:green;
            color:white;
            border:none;
            cursor:pointer;
            border-radius:4px;
        }

        button:hover { background:darkgreen; }
    </style>
</head>
<body>

<header style="display:flex; justify-content:space-between; align-items:center; padding:10px 20px; background:#f5f5f5; border-bottom:2px solid #ddd;">
    <h2>DMA Process Timeline</h2>
    <div>
        {{user}} | <a href="/logout">Logout</a>
    </div>
</header>

<!-- STEPPER -->
<div class="stepper-wrapper">
    {{#each processes}}
    <div class="stepper-item {{#if (includes ../completedProcesses this.id)}}completed{{/if}}">
        <div class="step-counter">
            {{#if (includes ../completedProcesses this.id)}}✓{{else}}{{inc @index}}{{/if}}
        </div>
        <div class="step-name">{{this.name}}</div>
    </div>
    {{/each}}
</div>

<!-- QUESTIONS -->
{{#if selectedProcess}}
<div class="question-container">
    <h2>{{selectedProcess.name}} Questionnaire</h2>

